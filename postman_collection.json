              "raw": "{{baseUrl}}/cart/deleteItemFromCart/:itemID",
              "host": ["{{baseUrl}}"], "path": ["cart", "deleteItemFromCart", ":itemID"],
              "variable": [{ "key": "itemID", "value": "" }]
            }
          }
        },
        {
          "name": "Empty Cart",
          "request": {
            "method": "POST", "header": [],
            "url": { "raw": "{{baseUrl}}/cart/emptyCart", "host": ["{{baseUrl}}"], "path": ["cart", "emptyCart"] }
          }
        }
      ]
    },
