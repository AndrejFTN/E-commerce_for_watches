          "name": "Admin - Get Orders For User By Status",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/admin/getOrdersByStatus/:username?status=",
              "host": ["{{baseUrl}}"], "path": ["order", "admin", "getOrdersByStatus", ":username"],
              "query": [{ "key": "status", "value": "" }],
              "variable": [{ "key": "username", "value": "" }]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT", "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/cancelOrder/:orderID",
              "host": ["{{baseUrl}}"], "path": ["order", "cancelOrder", ":orderID"],
              "variable": [{ "key": "orderID", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "Request",
      "item": [
        {
          "name": "Send Request",
          "request": {
            "method": "POST", "header": [],
            "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/request/sendRequest", "host": ["{{baseUrl}}"], "path": ["request", "sendRequest"] }
          }
        }
      ]
    }
  ]
}
